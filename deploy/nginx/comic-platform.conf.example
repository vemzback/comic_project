# Replace every angle-bracket placeholder before enabling this configuration.
# Keep certificates, private keys, and host-specific values outside the repository.

# Reject unknown HTTP hosts.
server {
    listen 80 default_server;
    server_name _;

    return 444;
}

# Redirect the canonical HTTP host to HTTPS. Keep this location for HTTP-01 ACME challenges.
server {
    listen 80;
    server_name <DOMAIN>;

    location ^~ /.well-known/acme-challenge/ {
        root <PROJECT_PUBLIC_PATH>;
        try_files $uri =404;
    }

    location / {
        return 308 https://<DOMAIN>$request_uri;
    }
}

# Serve the Laravel application over HTTPS.
server {
    listen 443 ssl http2;
    server_name <DOMAIN>;

    root <PROJECT_PUBLIC_PATH>;
    index index.php;

    ssl_certificate <TLS_CERTIFICATE_PATH>;
    ssl_certificate_key <TLS_PRIVATE_KEY_PATH>;

    client_max_body_size 3m;

    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Hashed Vite assets can be cached until their content hash changes.
    location ^~ /build/assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Do not expose hidden files, except the ACME challenge namespace above.
    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Only Laravel's front controller may be passed to PHP-FPM.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass <PHP_FPM_ENDPOINT>;
    }
}
